# Version control: ignore generated/generated and secrets so Git tracks only source changes.

# Environment and secrets
.env
.env.local
.env.*.local
*.pem

# Python
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# Database and scan output (optional: remove these lines if you want to commit sample data)
data/*.db
data/scans/

# Logs (optional: remove if you want to commit logs for FYP)
logs/
*.log

# IDE and OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Node (if you add npm later)
node_modules/
npm-debug.log*

# WeasyPrint / PDF temp
*.tmp
