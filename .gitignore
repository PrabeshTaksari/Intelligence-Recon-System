# ----- Version control: ignore these so Git tracks only source code -----

# Environment and secrets (never commit)
.env
.env.local
.env.*.local
*.pem

# Python
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# Database and scan output (generated at runtime)
data/irs.db
data/irs.db-journal
data/scans/

# Logs (generated at runtime)
logs/
*.log

# Node / Frontend (if you add npm later)
node_modules/
Frontend/node_modules/
npm-debug.log*

# IDE and OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Optional: keep structure but ignore large/generated files
# data/
# !data/.gitkeep
